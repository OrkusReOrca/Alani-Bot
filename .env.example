# Copy this file to ".env" and fill in your real values.
# NEVER commit the real ".env" file — it's already in .gitignore.

# Bot token from the Discord Developer Portal (Bot tab).
DISCORD_BOT_TOKEN=

# Your Discord user ID (for status-change DMs). Enable Developer Mode in
# Discord, right-click your name, "Copy User ID".
DISCORD_USER_ID=

# Channel ID the bot posts the daily update to. Right-click the channel,
# "Copy Channel ID".
DISCORD_CHANNEL_ID=
