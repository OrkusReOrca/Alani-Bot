# Copy this file to ".env" and fill in your real values.
# NEVER commit the real ".env" file — it's already in .gitignore.

# --- Webhook delivery (posts to a channel) ---
# Discord webhook URL. Regenerate it in Discord first if it was ever pasted
# into a chat, since anyone with the URL can post to the channel.
DISCORD_WEBHOOK_URL=

# --- Bot delivery (for DMs, optional) ---
# Bot token from the Discord Developer Portal (Bot tab).
DISCORD_BOT_TOKEN=
# Your Discord user ID (for DMs). Enable Developer Mode in Discord,
# right-click your name, "Copy User ID".
DISCORD_USER_ID=

# Optional: if you'd rather have the bot post to a channel instead of (or
# in addition to) the webhook, set the channel ID here.
DISCORD_CHANNEL_ID=
