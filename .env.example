# Copy this file to ".env" and fill in your real values.
# NEVER commit the real ".env" file — it's already in .gitignore.

# Bot token from the Discord Developer Portal (Bot tab).
DISCORD_BOT_TOKEN=

# Application ID from the Discord Developer Portal (General Information tab).
# Only needed to register slash commands (`npm run deploy-commands`) — the
# persistent bot itself only needs DISCORD_BOT_TOKEN.
DISCORD_CLIENT_ID=

# Your Discord user ID (for status-change DMs). Enable Developer Mode in
# Discord, right-click your name, "Copy User ID".
DISCORD_USER_ID=

# Channel ID the bot posts the daily uni-application-updater update to.
# Right-click the channel, "Copy Channel ID".
DISCORD_CHANNEL_ID=

# Channel ID (in the friend server) the bot posts Fortnite Jam Tracks
# updates to.
DISCORD_FORTNITE_CHANNEL_ID=

# Channel ID of the "Orkus Info" channel — admin db commands (".a db ...")
# only respond here. Right-click the channel, "Copy Channel ID".
DISCORD_COMMAND_BOX=

# The only two user IDs allowed to use ".a db ..." (admin-level access to
# orkus-info and any future database) — anyone else gets "Unauthorized
# user, no permission". Enable Developer Mode in Discord, right-click a
# name, "Copy User ID". DISCORD_OWNER_0 is also the default DM target for
# reminders added via voice — see src/features/db/voiceApi.js.
DISCORD_OWNER_0=
DISCORD_OWNER_1=

# Shared secret for voice-Alani's HTTP bridge (src/features/db/voiceApi.js)
# — generate any long random string, put the SAME value in voice-Alani's
# own .env as ALANI_BOT_API_SECRET. If unset, the voice bridge is disabled
# entirely (bot still runs fine otherwise).
VOICE_API_SECRET=

# Which port voiceApi.js listens on. Defaults to bot-hosting.net's own
# SERVER_PORT env var (already set automatically per-deployment) if this
# is left blank — only set it explicitly for local dev outside that host.
VOICE_API_PORT=

# Google Calendar sync (src/common/googleCalendar.js) — the ENTIRE
# downloaded service-account JSON key, as one value (paste the whole
# file's contents). Shared across every database's calendar sync; which
# calendar a given database syncs TO is that database's own config (see
# ORKUS_INFO_GOOGLE_CALENDAR_ID below, and src/features/orkus-info/README.md
# for full setup steps, including the Google Cloud Console side). If unset,
# calendar sync is disabled entirely — reminders/db features are unaffected.
GOOGLE_SERVICE_ACCOUNT_KEY=

# Calendar ID of the Google Calendar orkus-info's events sync to — create
# a calendar in your own Google Calendar, share it with the service
# account's email (from the JSON key's "client_email" field) with "make
# changes to events" permission, then copy the Calendar ID from that
# calendar's Settings -> "Integrate calendar".
ORKUS_INFO_GOOGLE_CALENDAR_ID=

# Lets ".a fjamtrack refresh" (bot owners only) force an immediate
# fortnite-jam-tracks-tracker shop re-check + re-post via the GitHub API,
# instead of waiting on the scheduled cron (which can run hours late — see
# the root README's "A note on scheduled workflow timing"). Create a
# fine-grained personal access token (GitHub -> Settings -> Developer
# settings -> Fine-grained tokens) scoped to ONLY this repository, with
# "Actions: Read and write" + "Contents: Read-only" repository
# permissions. If unset, ".a fjamtrack refresh" just replies that it's not
# configured — everything else in the bot is unaffected.
GITHUB_ACTIONS_TOKEN=
# "owner/repo" this bot's code lives in, e.g. OrkusReOrca/Alani-Bot.
GITHUB_REPO=

# Auth for the uni-tracker push route (src/features/uni-application-updater/
# pushApi.js) — generate any long random string; whatever refreshes
# programs.json (currently a scheduled cloud routine) needs the identical
# value. If unset, that route is disabled — everything else is unaffected.
UNI_TRACKER_PUSH_SECRET=

# ".a emo ..." only responds in this one channel — right-click it, "Copy
# Channel ID".
DISCORD_EMOTION_CHANNEL=

# "Alani Emotion" — the separate Python service this bot's ".a emo"
# command talks to (see src/features/emotion-detect/README.md). Its own
# bot-hosting.net Network-tab address, and a shared secret (generate any
# long random string, put the identical value in that service's own env).
# If either is unset, ".a emo" replies that it's not configured.
EMOTION_SERVICE_URL=
EMOTION_SERVICE_SECRET=

# Channel ID of the status channel — Alani posts one-line updates here
# (online/offline, tracker runs, cloud backups, database changes; see
# src/common/statusLog.js). Also add it as a GitHub Actions secret named
# DISCORD_STATUS_CHANNEL so the Fortnite tracker's post shows up here too.
DISCORD_STATUS_CHANNEL=

# Cloud backup (src/features/cloud-backup/README.md): databases + settings are
# saved, encrypted, to a private Discord channel. DISCORD_BACKUP_CHANNEL is
# that channel's ID (only you and the bot should be able to see it).
# BACKUP_ENCRYPTION_KEY is 64 hex characters — generate one with
# `npm run backup-key` and KEEP A COPY somewhere safe (a password manager):
# without it the backups can't be decrypted. If either is unset, backups are
# skipped.
DISCORD_BACKUP_CHANNEL=
BACKUP_ENCRYPTION_KEY=
