node_modules/
.env
*.log

# Live databases (SQLite) — unlike the JSON state files elsewhere in data/,
# these change constantly and don't need git history; they live on the
# bot's own persistent host storage instead. See src/features/*/db.js.
*.db
*.db-journal
*.db-wal
*.db-shm

# Python (emotion-service/)
__pycache__/
*.pyc
venv/
.venv/

# Alani Emotion's own persistent state (per-clip cache JSON + the status/
# history CSV) — lives on that deployment's own disk, same reasoning as
# the SQLite files above: it changes constantly and doesn't need git
# history.
emotion-service/data/

# Runtime state of the cloud backup (last-run time, unresolved faults, the
# host-side copy of a faulty snapshot) and the online/offline heartbeat —
# machine-local, like the databases above.
data/cloud-backup/
data/status/
